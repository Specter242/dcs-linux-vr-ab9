+    bool loadTgaAlpha(
+      const char*           path,
+            uint32_t        expectedWidth,
+            uint32_t        expectedHeight,
+            std::vector<uint8_t>& alpha) {
+      std::ifstream file(path, std::ios::binary);
+      if (!file)
+        return false;
+
+      uint8_t header[18] = { };
+      file.read(reinterpret_cast<char*>(header), sizeof(header));
+      if (!file || header[1] != 0 || (header[2] != 2 && header[2] != 10)
+       || header[16] != 32 || readLe16(header + 12) != expectedWidth
+       || readLe16(header + 14) != expectedHeight)
+        return false;
+
+      file.seekg(header[0], std::ios::cur);
+      if (!file)
+        return false;
+
+      const bool topOrigin = header[17] & 0x20;
+      const bool rightOrigin = header[17] & 0x10;
+      const size_t pixelCount = size_t(expectedWidth) * expectedHeight;
+      alpha.resize(pixelCount);
+
+      auto storePixel = [&] (size_t fileIndex, const uint8_t* pixel) {
+        const uint32_t fileY = uint32_t(fileIndex / expectedWidth);
+        const uint32_t fileX = uint32_t(fileIndex % expectedWidth);
+        const uint32_t y = topOrigin ? fileY : expectedHeight - 1 - fileY;
+        const uint32_t x = rightOrigin ? expectedWidth - 1 - fileX : fileX;
+        alpha[size_t(y) * expectedWidth + x] = pixel[3];
+      };
+
+      size_t output = 0;
+      uint8_t pixel[4];
+      if (header[2] == 2) {
+        while (output < pixelCount) {
+          file.read(reinterpret_cast<char*>(pixel), sizeof(pixel));
+          if (!file)
+            return false;
+          storePixel(output++, pixel);
+        }
+      } else {
+        while (output < pixelCount) {
+          uint8_t packet = 0;
+          file.read(reinterpret_cast<char*>(&packet), 1);
+          if (!file)
+            return false;
+          const uint32_t count = (packet & 0x7f) + 1;
+          if (output + count > pixelCount)
+            return false;
+          if (packet & 0x80) {
+            file.read(reinterpret_cast<char*>(pixel), sizeof(pixel));
+            if (!file)
+              return false;
+            for (uint32_t i = 0; i < count; i++)
+              storePixel(output++, pixel);
+          } else {
+            for (uint32_t i = 0; i < count; i++) {
+              file.read(reinterpret_cast<char*>(pixel), sizeof(pixel));
+              if (!file)
+                return false;
+              storePixel(output++, pixel);
+            }
+          }
+        }
+      }
+
+      return true;
+    }
