+    uint64_t hashRgbaTexture(
+      const D3D11_COMMON_TEXTURE_DESC& desc,
+      const D3D11_SUBRESOURCE_DATA&    data) {
+      uint64_t hash = 1469598103934665603ull;
+      const auto* base = reinterpret_cast<const uint8_t*>(data.pSysMem);
+      const uint32_t rowBytes = std::min<uint32_t>(data.SysMemPitch, desc.Width * 4);
+      for (uint32_t y = 0; y < desc.Height; y++) {
+        const auto* row = base + size_t(y) * data.SysMemPitch;
+        for (uint32_t x = 0; x < rowBytes; x++) {
+          hash ^= row[x];
+          hash *= 1099511628211ull;
+        }
+      }
+      return hash;
+    }
