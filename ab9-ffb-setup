#!/bin/sh
# Persistently attach the MOZA AB9 HID interface to hid-universal-pidff.
set -eu

driver_dir=/sys/bus/hid/drivers/hid-universal-pidff
dynamic_id='0003 0000346E 00001000'

/usr/bin/modprobe hid-universal-pidff

# EEXIST only means this dynamic ID was already registered in this boot.
if ! printf '%s\n' "$dynamic_id" >"$driver_dir/new_id" 2>/dev/null; then
    :
fi

if [ "${1:-}" = "--new-id-only" ]; then
    exit 0
fi

# Boot fallback: if enumeration beat modules-load/udev, move an already-bound
# AB9 from hid-generic to the universal PIDFF driver.
for device_path in /sys/bus/hid/devices/0003:346E:1000.*; do
    [ -e "$device_path" ] || continue
    device_name=${device_path##*/}
    current_driver=
    if [ -L "$device_path/driver" ]; then
        current_driver=$(basename "$(readlink -f "$device_path/driver")")
    fi
    [ "$current_driver" = hid-universal-pidff ] && continue

    if [ -n "$current_driver" ] && [ -w "/sys/bus/hid/drivers/$current_driver/unbind" ]; then
        printf '%s\n' "$device_name" >"/sys/bus/hid/drivers/$current_driver/unbind"
    fi
    printf '%s\n' "$device_name" >"$driver_dir/bind"
done
